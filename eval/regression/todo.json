    "click:#add",
    "click:#add",
    "type:#item:B",
    "click:#add"
   ],
   "observe": "#todo li:nth-child(2)",
   "expect": "A"
  },
  {
   "id": "t02",
   "app": "todo",
   "screen": "add",
   "text": "a whitespace-only task is accepted as a (blank) task",
   "steps": [
    "type:#item:   ",
    "click:#add",
    "type:#item:B",
    "click:#add"
   ],
   "observe": "#todo li:nth-child(2)",
   "expect": ""
  },
  {
