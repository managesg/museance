{
 "app": "todo",
 "original": "runs/todo/original/index.html (themaxsandelin/todo, MIT; observed in Playwright Chromium, 3 runs each, identical)",
 "good": [
  {
   "id": "g01",
   "app": "todo",
   "screen": "add",
   "text": "clicking add puts the typed task in the todo list",
   "steps": [
    "type:#item:Buy milk",
    "click:#add"
   ],
   "observe": "#todo",
   "expect": "Buy milk"
  },
  {
   "id": "g02",
   "app": "todo",
   "screen": "add",
   "text": "pressing Enter in the input adds the task",
   "steps": [
    "type:#item:Buy milk",
    "key:Enter"
   ],
   "observe": "#todo",
   "expect": "Buy milk"
  },
  {
   "id": "g03",
   "app": "todo",
   "screen": "add",
   "text": "newest task is listed first",
   "steps": [
    "type:#item:Buy milk",
    "click:#add",
    "type:#item:Walk dog",
    "click:#add"
   ],
   "observe": "#todo",
   "expect": "Walk dog\nBuy milk"
  },
  {
   "id": "g04",
   "app": "todo",
   "screen": "add",
   "text": "three tasks are listed newest first",
   "steps": [
    "type:#item:A",
    "click:#add",
    "type:#item:B",
    "click:#add",
    "type:#item:C",
    "click:#add"
   ],
   "observe": "#todo",
   "expect": "C\nB\nA"
  },
  {
   "id": "g05",
   "app": "todo",
   "screen": "complete",
   "text": "completing a task moves it to the completed list",
   "steps": [
    "type:#item:Buy milk",
    "click:#add",
    "click:#todo li .complete"
   ],
   "observe": "#completed",
   "expect": "Buy milk"
  },
  {
   "id": "g06",
   "app": "todo",
   "screen": "complete",
   "text": "completing a task takes it out of the todo list (the other stays)",
   "steps": [
    "type:#item:A",
    "click:#add",
    "type:#item:B",
    "click:#add",
    "click:#todo li .complete"
   ],
   "observe": "#todo",
   "expect": "A"
  },
  {
   "id": "g07",
   "app": "todo",
   "screen": "complete",
   "text": "completed list shows the newest completed task first",
   "steps": [
    "type:#item:A",
    "click:#add",
    "type:#item:B",
    "click:#add",
    "click:#todo li .complete",
    "click:#todo li .complete"
   ],
   "observe": "#completed",
   "expect": "A\nB"
  },
  {
   "id": "g08",
   "app": "todo",
   "screen": "complete",
   "text": "completing again un-completes: task returns to todo",
   "steps": [
    "type:#item:Buy milk",
    "click:#add",
    "click:#todo li .complete",
    "click:#completed li .complete"
   ],
   "observe": "#todo",
   "expect": "Buy milk"
  },
  {
   "id": "g09",
   "app": "todo",
   "screen": "remove",
   "text": "remove deletes a task from the todo list",
   "steps": [
    "type:#item:A",
    "click:#add",
    "type:#item:B",
    "click:#add",
    "click:#todo li .remove"
   ],
   "observe": "#todo",
   "expect": "A"
  },
  {
   "id": "g10",
   "app": "todo",
   "screen": "remove",
   "text": "remove deletes a task from the completed list",
   "steps": [
    "type:#item:A",
    "click:#add",
    "type:#item:B",
    "click:#add",
    "click:#todo li .complete",
    "click:#todo li .complete",
    "click:#completed li .remove"
   ],
   "observe": "#completed",
   "expect": "B"
  },
  {
   "id": "g11",
   "app": "todo",
   "screen": "add",
   "text": "clicking add a second time on the now-empty input adds nothing more",
   "steps": [
    "type:#item:Buy milk",
    "click:#add",
    "click:#add"
   ],
   "observe": "#todo",
   "expect": "Buy milk"
  },
  {
   "id": "g12",
   "app": "todo",
   "screen": "remove",
   "text": "deleting the last task then adding another works",
   "steps": [
    "type:#item:A",
    "click:#add",
    "click:#todo li .remove",
    "type:#item:B",
    "click:#add"
   ],
   "observe": "#todo",
   "expect": "B"
  }
 ],
